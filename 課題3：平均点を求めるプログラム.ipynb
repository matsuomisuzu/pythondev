     "text": [
      "10人のテストの平均点は73.4点です\n"
     ]
    }
   ],
   "source": [
    "count = 0\n",
    "total = 0\n",
    "while True:\n",
    "    i = int(input(\"点数を入力して下さい：\"))\n",
    "    if i == -1:\n",
    "        break\n",
    "    \n",
    "    total += i \n",
    "    count += 1\n",
    "\n",
    "print(f\"{count}人のテストの平均点は{round(total/count ,1)}点です\")"
   ]
  }
 ],
